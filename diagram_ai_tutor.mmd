flowchart TD

  USER(["👤 Student / Tutor User"])

  CF["☁️ CloudFront CDN\n+ S3 Static SPA"]

  API["⚡ FastAPI — EC2 t4g.small\nap-southeast-2 · Docker"]

  CS["ChatService\nPedagogy-mode prompts"]

  CVS["ContextVectorService\nRAG retrieval"]

  NEO["🔵 Neo4j\nVector Store\nANN search · Bolt :7687"]

  EMBED["Bedrock — Cohere Embed v3\nDocument embeddings · 1024-dim"]

  NOVA["Bedrock — Nova Lite v1\nChat responses & Code edits"]

  DDB["DynamoDB — chat_sessions\nConversation history\nGSI: UserSessionsIndex · TTL 30d"]

  AUTH["DynamoDB — auth_users\nJWT · Google OAuth\nSES password reset"]

  CW["CloudWatch\nLogs · Alarms"]

  %% ── Flow ──────────────────────────────────────────────────────────────────

  USER -- "HTTPS" --> CF
  USER -- "REST API" --> API

  API -- "chat / code\nrequest" --> CS

  CS -- "retrieve\ncontext" --> CVS
  CVS -- "vector search" --> NEO
  NEO -- "top-k chunks" --> CVS
  CVS -- "context +\nmessages" --> CS

  CS -- "InvokeModel" --> NOVA
  NOVA -- "streamed\nresponse" --> API

  API -- "read / write\nmessages" --> DDB
  API -- "auth" --> AUTH

  EMBED -- "upsert\nembeddings" --> NEO

  API -. "logs" .-> CW

  %% ── Styles ────────────────────────────────────────────────────────────────

  classDef actor    fill:#EDE7F6,stroke:#5E35B1,color:#0D1B2A,font-weight:bold
  classDef frontend fill:#E3F2FD,stroke:#1565C0,color:#0D1B2A
  classDef compute  fill:#FFF8E7,stroke:#E65100,color:#0D1B2A,font-weight:bold
  classDef svc      fill:#E8F5E9,stroke:#2E7D32,color:#0D1B2A
  classDef ml       fill:#F3E5F5,stroke:#6A1B9A,color:#0D1B2A
  classDef db       fill:#FFF3E0,stroke:#BF360C,color:#0D1B2A
  classDef ops      fill:#ECEFF1,stroke:#455A64,color:#0D1B2A

  class USER actor
  class CF frontend
  class API compute
  class CS,CVS svc
  class NOVA,EMBED ml
  class NEO,DDB,AUTH db
  class CW ops
