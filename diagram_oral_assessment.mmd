flowchart TD

  %% ── Actors ────────────────────────────────────────────────────────────────
  INST(["👩‍🏫 Instructor"])
  STU(["👨‍🎓 Student"])

  %% ── Frontends ─────────────────────────────────────────────────────────────
  S3I["🪣 S3 — instructor-app\nReact SPA · us-east-1"]
  S3S["🪣 S3 — student-app\nReact SPA · us-east-1"]

  %% ── API ───────────────────────────────────────────────────────────────────
  API["⚡ FastAPI — EC2 t4g.small\nap-southeast-2 · Docker"]

  %% ── Instructor path ───────────────────────────────────────────────────────
  QG["QuestionGenerationService\n(batch · Bedrock)"]
  SQS["📨 SQS — ai-tutor-jobs\nAsync · Visibility 900s"]
  DLQ["☠️ SQS DLQ\nmaxReceive: 3"]
  BJM["BatchJobManager\nDynamoDB job state\nPENDING → RUNNING → DONE"]

  %% ── Student path ──────────────────────────────────────────────────────────
  OAS["OralAssessmentService\n(question access · submission)"]
  S3F["🪣 S3 — assessment-files\nAudio/Video upload\nPresigned PUT · Lifecycle 1yr"]
  STT["SpeechToTextService\n→ Deepgram API (HTTPS)"]
  REE["ResponseEvaluationEngine\n(score + written feedback)"]

  %% ── Shared AI ─────────────────────────────────────────────────────────────
  NOVA["☁️ Bedrock — Nova Lite v1\nQuestion generation\nResponse evaluation"]

  %% ── Storage ───────────────────────────────────────────────────────────────
  DDB["DynamoDB — oral_assessments\nASSESSMENT# · STUDENT# · QUESTION# · JOB#\nGSI: InstructorAssessmentsIndex · TTL 7d"]

  %% ── Ops ───────────────────────────────────────────────────────────────────
  SES["📧 SES — assessments@chat9021.org\nStudent invitations"]
  CW["📊 CloudWatch\nLogs · DLQ alarm"]

  %% ── Instructor flow ───────────────────────────────────────────────────────
  INST -- "HTTPS" --> S3I
  INST -- "REST API" --> API
  API -- "create assessment\nenrol students" --> DDB
  API -- "generate\nquestions" --> QG
  QG -- "1 · enqueue job\n(Async · SQS)" --> SQS
  SQS -- "2 · receive &\nconsume" --> BJM
  BJM -- "3 · execute\ngeneration" --> NOVA
  NOVA -- "4 · questions\ngenerated" --> DDB
  SQS -- "failure ×3" --> DLQ
  DLQ -. "alarm" .-> CW
  API -- "SendEmail" --> SES

  %% ── Student flow ──────────────────────────────────────────────────────────
  STU -- "HTTPS" --> S3S
  STU -- "REST API" --> API
  API -- "fetch\nquestion" --> OAS
  OAS -- "read question" --> DDB
  STU -- "direct upload\n(presigned PUT)" --> S3F
  API -- "submit answer" --> OAS
  OAS -- "transcribe" --> STT
  STT -- "InvokeModel" --> NOVA
  STT --> REE
  REE -- "InvokeModel" --> NOVA
  NOVA -- "score +\nfeedback" --> REE
  REE -- "write evaluation" --> DDB

  API -. "logs" .-> CW

  %% ── Styles ────────────────────────────────────────────────────────────────
  classDef actor    fill:#EDE7F6,stroke:#5E35B1,color:#0D1B2A,font-weight:bold
  classDef frontend fill:#E3F2FD,stroke:#1565C0,color:#0D1B2A
  classDef compute  fill:#FFF8E7,stroke:#E65100,color:#0D1B2A,font-weight:bold
  classDef svc      fill:#E8F5E9,stroke:#2E7D32,color:#0D1B2A
  classDef ml       fill:#F3E5F5,stroke:#6A1B9A,color:#0D1B2A
  classDef db       fill:#FFF3E0,stroke:#BF360C,color:#0D1B2A
  classDef ops      fill:#ECEFF1,stroke:#455A64,color:#0D1B2A
  classDef async    fill:#FFFDE7,stroke:#F9A825,color:#0D1B2A
  classDef storage  fill:#F1F8E9,stroke:#558B2F,color:#0D1B2A

  class INST,STU actor
  class S3I,S3S frontend
  class API compute
  class QG,OAS,STT,REE,BJM svc
  class NOVA ml
  class DDB db
  class SES,CW ops
  class SQS,DLQ async
  class S3F storage
